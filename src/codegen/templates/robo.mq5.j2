class CNode
  {
public:
   virtual          ~CNode(void) {}
   virtual double    Step(const BarData &b) { return 0.0; }
  };

bool AcceptValue(const double x, long &seen)
  {
   if(IsNaN(x)) { if(seen > 0) g_fault = true; return false; }
   seen++;
   return true;
  }

class CField : public CNode
  {
   int               m_f;
public:
                     CField(const int f) { m_f = f; }
   virtual double    Step(const BarData &b)
     {
      if(m_f == F_CLOSE)  return b.close;
      if(m_f == F_HIGH)   return b.high;
      if(m_f == F_LOW)    return b.low;
      if(m_f == F_VOLUME) return b.volume;
      return b.trades;
     }
  };

class CRef : public CNode
  {
   int               m_r;
public:
                     CRef(const int r) { m_r = r; }
   virtual double    Step(const BarData &b) { return m_r == R_ES ? b.es : b.wdo; }
  };

class CConst : public CNode
  {
   double            m_v;
public:
                     CConst(const double v) { m_v = v; }
   virtual double    Step(const BarData &b) { return m_v; }
  };

class CInWindow : public CNode
  {
   int               m_lo, m_hi;
public:
                     CInWindow(const int lo, const int hi) { m_lo = lo; m_hi = hi; }
   virtual double    Step(const BarData &b) { return (b.tod > m_lo && b.tod <= m_hi) ? 1.0 : 0.0; }
  };

class CMinutesSinceOpen : public CNode
  {
   int               m_day;
   long              m_first;
public:
                     CMinutesSinceOpen(void) { m_day = -1; m_first = 0; }
   virtual double    Step(const BarData &b)
     {
      long minutes = (long)(b.close_time / 60);
      if(b.day_key != m_day) { m_day = b.day_key; m_first = minutes; }
      return (double)(minutes - m_first + 1);
     }
  };

class CLag : public CNode
  {
   CNode            *m_c;
   int               m_mode;
   CRing             m_buf;
public:
                     CLag(CNode *c, const int k, const int mode) { m_c = c; m_mode = mode; m_buf.Init(k + 1); }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      m_buf.Push(x);
      if(!m_buf.Full()) return NaNValue();
      double old = m_buf.At(0);
      if(m_mode == LM_LAG) return old;
      if(IsNaN(x) || IsNaN(old)) return NaNValue();
      if(m_mode == LM_DELTA) return x - old;
      if(MathAbs(old) < GUARD_EPS) return 0.0;
      return x / old - 1.0;
     }
  };

class CRollingMean : public CNode
  {
   CNode            *m_c;
   CRing             m_win;
   double            m_total;
   int               m_since, m_w;
   long              m_seen;
public:
                     CRollingMean(CNode *c, const int w) { m_c = c; m_w = w; m_win.Init(w); m_total = 0.0; m_since = 0; m_seen = 0; }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      if(!AcceptValue(x, m_seen)) return NaNValue();
      if(m_win.Full()) m_total -= m_win.At(0);
      m_win.Push(x); m_total += x; m_since++;
      if(m_since >= m_w)
        {
         m_total = 0.0;
         for(int k = 0; k < m_win.m_size; k++) m_total += m_win.At(k);
         m_since = 0;
        }
      return m_win.Full() ? m_total / m_w : NaNValue();
     }
  };

class CRollingStd : public CNode
  {
   CNode            *m_c;
   CWelford          m_wf;
   long              m_seen;
public:
                     CRollingStd(CNode *c, const int w) { m_c = c; m_wf.Init(w); m_seen = 0; }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      if(!AcceptValue(x, m_seen)) return NaNValue();
      m_wf.Push(x);
      return m_wf.m_win.Full() ? m_wf.Std() : NaNValue();
     }
  };

class CZScore : public CNode
  {
   CNode            *m_c;
   CWelford          m_wf;
   long              m_seen;
public:
                     CZScore(CNode *c, const int w) { m_c = c; m_wf.Init(w); m_seen = 0; }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      if(!AcceptValue(x, m_seen)) return NaNValue();
      m_wf.Push(x);
      if(!m_wf.m_win.Full()) return NaNValue();
      double sd = m_wf.Std();
      return sd < GUARD_EPS ? 0.0 : (x - m_wf.m_mean) / sd;
     }
  };

class CExtreme : public CNode
  {
   CNode            *m_c;
   CMonoDeque        m_dq;
   long              m_i, m_seen;
   int               m_w;
public:
                     CExtreme(CNode *c, const int w, const bool is_max) { m_c = c; m_w = w; m_dq.Init(w, is_max); m_i = 0; m_seen = 0; }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      if(!AcceptValue(x, m_seen)) return NaNValue();
      m_dq.Push(m_i, x); m_i++;
      return m_seen >= m_w ? m_dq.Value() : NaNValue();
     }
  };

class CEma : public CNode
  {
   CNode            *m_c;
   double            m_alpha, m_e;
   int               m_w;
   long              m_seen;
public:
                     CEma(CNode *c, const int w) { m_c = c; m_w = w; m_alpha = 2.0 / (w + 1); m_e = 0.0; m_seen = 0; }
   virtual double    Step(const BarData &b)
     {
      double v = m_c.Step(b);
      if(IsNaN(v)) { if(m_seen > 0) g_fault = true; return NaNValue(); }
      m_e = (m_seen == 0) ? v : m_e + m_alpha * (v - m_e);
      m_seen++;
      return m_seen >= m_w ? m_e : NaNValue();
     }
  };

class CRankTs : public CNode
  {
   CNode            *m_c;
   CRing             m_win;
   int               m_w;
   long              m_seen;
public:
                     CRankTs(CNode *c, const int w) { m_c = c; m_w = w; m_win.Init(w); m_seen = 0; }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      if(!AcceptValue(x, m_seen)) return NaNValue();
      m_win.Push(x);
      if(!m_win.Full()) return NaNValue();
      if(m_w == 1) return 0.0;
      int less = 0, equal = -1;
      for(int k = 0; k < m_win.m_size; k++)
        {
         double v = m_win.At(k);
         if(v < x) less++;
         else if(v == x) equal++;
        }
      return 2.0 * (less + 0.5 * equal) / (m_w - 1) - 1.0;
     }
  };

class CClip : public CNode
  {
   CNode            *m_c;
   double            m_lo, m_hi;
public:
                     CClip(CNode *c, const double lo, const double hi) { m_c = c; m_lo = lo; m_hi = hi; }
   virtual double    Step(const BarData &b)
     {
      double x = m_c.Step(b);
      if(IsNaN(x)) return NaNValue();
      return MathMin(MathMax(x, m_lo), m_hi);
     }
  };

class CBinary : public CNode
  {
   CNode            *m_a, *m_b;
   int               m_op;
public:
                     CBinary(const int op, CNode *a, CNode *b) { m_op = op; m_a = a; m_b = b; }
   virtual double    Step(const BarData &bar)
     {
      double a = m_a.Step(bar);
      double b = m_b.Step(bar);
      if(m_op == B_ADD) return a + b;
      if(m_op == B_SUB) return a - b;
      if(m_op == B_MUL) return a * b;
      if(IsNaN(a) || IsNaN(b)) return NaNValue();
      if(m_op == B_DIV) return MathAbs(b) < GUARD_EPS ? 0.0 : a / b;
      if(m_op == B_GT) return a > b ? 1.0 : 0.0;
      if(m_op == B_LT) return a < b ? 1.0 : 0.0;
      if(m_op == B_AND) return (a != 0.0 && b != 0.0) ? 1.0 : 0.0;
      return (a != 0.0 || b != 0.0) ? 1.0 : 0.0;
     }
  };

