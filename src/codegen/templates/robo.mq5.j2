class CRing
  {
public:
   double            m_buf[];
   int               m_cap, m_head, m_size;
   void              Init(const int cap) { m_cap = cap; ArrayResize(m_buf, cap); m_head = 0; m_size = 0; }
   bool              Full(void) { return m_size == m_cap; }
   double            At(const int i) { return m_buf[(m_head + i) % m_cap]; }   // 0 = mais antigo
   void              Push(const double v)
     {
      if(m_size == m_cap) { m_buf[m_head] = v; m_head = (m_head + 1) % m_cap; }
      else { m_buf[(m_head + m_size) % m_cap] = v; m_size++; }
     }
  };

class CMonoDeque
  {
public:
   long              m_idx[];
   double            m_val[];
   int               m_cap, m_head, m_size, m_w;
   bool              m_max;
   void              Init(const int w, const bool is_max)
     {
      m_w = w; m_max = is_max; m_cap = w + 1;
      ArrayResize(m_idx, m_cap); ArrayResize(m_val, m_cap); m_head = 0; m_size = 0;
     }
   void              Push(const long i, const double v)
     {
      while(m_size > 0)
        {
         int back = (m_head + m_size - 1) % m_cap;
         bool pop = m_max ? (m_val[back] <= v) : (m_val[back] >= v);
         if(!pop) break;
         m_size--;
        }
      int pos = (m_head + m_size) % m_cap;
      m_idx[pos] = i; m_val[pos] = v; m_size++;
      while(m_idx[m_head] <= i - m_w) { m_head = (m_head + 1) % m_cap; m_size--; }
     }
   double            Value(void) { return m_val[m_head]; }
  };

class CWelford
  {
public:
   CRing             m_win;
   CMonoDeque        m_hi, m_lo;
   int               m_n, m_since, m_w;
   long              m_i;
   double            m_mean, m_m2;
   void              Init(const int w)
     {
      m_w = w; m_win.Init(w); m_hi.Init(w, true); m_lo.Init(w, false);
      m_n = 0; m_since = 0; m_i = 0; m_mean = 0.0; m_m2 = 0.0;
     }
   void              Add(const double x) { m_n++; double d = x - m_mean; m_mean += d / m_n; m_m2 += d * (x - m_mean); }
   void              Remove(const double x)
     {
      m_n--;
      if(m_n == 0) { m_mean = 0.0; m_m2 = 0.0; return; }
      double d = x - m_mean; m_mean -= d / m_n; m_m2 -= d * (x - m_mean);
     }
   void              Push(const double v)
     {
      if(m_win.Full()) Remove(m_win.At(0));
      m_win.Push(v); Add(v);
      m_hi.Push(m_i, v); m_lo.Push(m_i, v); m_i++;
      m_since++;
      if(m_since >= m_w)   // ressincroniza a partir do buffer: erro nao se acumula
        {
         m_n = 0; m_mean = 0.0; m_m2 = 0.0;
         for(int k = 0; k < m_win.m_size; k++) Add(m_win.At(k));
         m_since = 0;
        }
     }
   double            Std(void)
     {
      if(m_n < 2 || m_hi.Value() == m_lo.Value()) return 0.0;
      double v = m_m2 / (m_n - 1);
      if(v < 0.0) v = 0.0;
      return MathSqrt(v);
     }
  };

