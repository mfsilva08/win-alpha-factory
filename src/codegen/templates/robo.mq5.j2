//+------------------------------------------------------------------+
//| Barras: sempre fechadas (indice >= 1)                            |
//+------------------------------------------------------------------+
bool LoadBar(const int shift, BarData &b)
  {
   if(shift < 1) return false;   // indice 0 e a barra em formacao: nunca
   MqlRates r[];
   if(CopyRates(_Symbol, PERIOD_M1, shift, 1, r) != 1) return false;
   b.close_time = r[0].time + 60;
   MqlDateTime dt;
   TimeToStruct(b.close_time, dt);
   b.tod = dt.hour * 60 + dt.min;
   b.day_key = dt.year * 10000 + dt.mon * 100 + dt.day;
   b.open = r[0].open; b.close = r[0].close; b.high = r[0].high; b.low = r[0].low;
   b.volume = (double)r[0].real_volume;   // contratos
   b.trades = (double)r[0].tick_volume;   // negocios (ver SPEC-fase-3 §3.12)
   b.es = 0.0; b.wdo = 0.0;
{%- if needs_es %}
   int s_es = iBarShift(InpRefES, PERIOD_M1, r[0].time, true);
   if(s_es < 1) return false;            // referencia sem barra fechada no mesmo minuto
   b.es = iClose(InpRefES, PERIOD_M1, s_es);
{%- endif %}
{%- if needs_wdo %}
   int s_wdo = iBarShift(InpRefWDO, PERIOD_M1, r[0].time, true);
   if(s_wdo < 1) return false;
   b.wdo = iClose(InpRefWDO, PERIOD_M1, s_wdo);
{%- endif %}
   return true;
  }

//+------------------------------------------------------------------+
//| Guards: espelho de src/codegen/guards.py                         |
//+------------------------------------------------------------------+
double ToGrid(const double price, const int side)
  {
   double q = price / TICK_SIZE;
   double steps = side > 0 ? MathCeil(q - 1e-9) : MathFloor(q + 1e-9);
   return steps * TICK_SIZE;
  }

bool OnGrid(const double price) { return MathAbs(price / TICK_SIZE - MathRound(price / TICK_SIZE)) < 1e-9; }

int MaxLots(void)
  {
   double equity = AccountInfoDouble(ACCOUNT_EQUITY);
   int lots = (int)MathFloor(equity / MARGIN_PER_CONTRACT);
   return lots < 0 ? 0 : lots;
  }

string GuardOrder(const int tod, const int lots, const double price)
  {
   if(g_consecutive_rej >= InpMaxRejections) return "BREAKER";
   if(g_daily_pnl_points <= -InpDailyLossPoints) return "DAILY_LOSS";
   if(tod >= CUTOFF_MIN || !(tod > SESSION_START_MIN && tod <= SESSION_END_MIN)) return "CUTOFF";
   if(lots < 1 || lots > MaxLots()) return "MARGIN";
   if(!OnGrid(price)) return "GRID";
   return "";
  }

int DecideSide(const double sig)
  {
   if(IsNaN(sig) || g_position != 0) return 0;
   double s = DIRECTION * sig;
   if(s > SIGNAL_THRESHOLD) return 1;
   if(s < -SIGNAL_THRESHOLD) return -1;
   return 0;
  }

//+------------------------------------------------------------------+
//| Metrica da kill_condition: {{ kill_metric }}
//+------------------------------------------------------------------+
void AccumulateTickMetric(void)
  {
{%- if kill_metric == "spread_ticks" %}
   MqlTick t;
   if(SymbolInfoTick(_Symbol, t) && t.ask > t.bid) { g_km_sum += (t.ask - t.bid) / TICK_SIZE; g_km_n++; }
{%- elif kill_metric == "lag_ms" %}
   MqlTick es, win;
   if(SymbolInfoTick(InpRefES, es) && es.last != g_es_last) { g_es_last = es.last; g_es_move_msc = es.time_msc; }
   if(SymbolInfoTick(_Symbol, win) && win.last != g_win_last)
     {
      g_win_last = win.last;
      if(g_es_move_msc > 0 && win.time_msc >= g_es_move_msc)
        { g_km_sum += (double)(win.time_msc - g_es_move_msc); g_km_n++; g_es_move_msc = 0; }
     }
{%- endif %}
  }

double ReturnsStd(const string sym, const int n)
  {
   double mean = 0.0, m2 = 0.0; int k = 0;
   for(int s = 1; s <= n; s++)
     {
      double c0 = iClose(sym, PERIOD_M1, s), c1 = iClose(sym, PERIOD_M1, s + 1);
      if(c0 <= 0.0 || c1 <= 0.0) continue;
      double x = c0 / c1 - 1.0; k++;
      double d = x - mean; mean += d / k; m2 += d * (x - mean);
     }
   return k > 1 ? MathSqrt(m2 / (k - 1)) : NaNValue();
  }

double ReturnsCorr(const string a, const string b, const int n)
  {
   double sa = 0, sb = 0, saa = 0, sbb = 0, sab = 0; int k = 0;
   for(int s = 1; s <= n; s++)
     {
      double a0 = iClose(a, PERIOD_M1, s), a1 = iClose(a, PERIOD_M1, s + 1);
      double b0 = iClose(b, PERIOD_M1, s), b1 = iClose(b, PERIOD_M1, s + 1);
      if(a1 <= 0.0 || b1 <= 0.0) continue;
      double x = a0 / a1 - 1.0, y = b0 / b1 - 1.0; k++;
      sa += x; sb += y; saa += x * x; sbb += y * y; sab += x * y;
     }
   if(k < 3) return NaNValue();
   double cov = sab - sa * sb / k, va = saa - sa * sa / k, vb = sbb - sb * sb / k;
   return (va <= 0 || vb <= 0) ? NaNValue() : cov / MathSqrt(va * vb);
  }

double KillMetricValue(const BarData &b)
  {
   double v = NaNValue();
{%- if kill_metric in ("spread_ticks", "lag_ms") %}
   if(g_km_n > 0) v = g_km_sum / g_km_n;
   g_km_sum = 0.0; g_km_n = 0;
{%- elif kill_metric == "realized_vol" %}
   v = ReturnsStd(_Symbol, METRIC_LOOKBACK);
{%- elif kill_metric == "gap_overnight" %}
   v = g_gap_points;
{%- elif kill_metric == "minutes_to_open" %}
   v = (double)(b.tod - SESSION_START_MIN);
{%- elif kill_metric == "ref_corr" %}
   v = ReturnsCorr(_Symbol, InpRefES, METRIC_LOOKBACK);
{%- elif kill_metric == "fill_ratio" %}
   if(g_orders_sent > 0) v = (double)g_orders_filled / g_orders_sent;
{%- endif %}
   return v;
  }

//+------------------------------------------------------------------+
//| Telemetria: uma linha por barra, com ou sem ordem                |
//+------------------------------------------------------------------+
string Num(const double x) { return IsNaN(x) ? "" : StringFormat("%.17g", x); }

string IsoMinute(const datetime t)
  {
   string s = TimeToString(t, TIME_DATE | TIME_MINUTES);
   StringReplace(s, ".", "-"); StringReplace(s, " ", "T");
   return s;
  }

void OpenDayFile(const BarData &b)
  {
   if(g_file != INVALID_HANDLE) FileClose(g_file);
   string name = StringFormat("telemetry\\win_%08d.csv", b.day_key);
   bool exists = FileIsExist(name);
   g_file = FileOpen(name, FILE_READ | FILE_WRITE | FILE_CSV | FILE_ANSI | FILE_SHARE_READ, ',');
   if(g_file == INVALID_HANDLE) return;
   FileSeek(g_file, 0, SEEK_END);
   if(!exists)
      FileWrite(g_file, "ts", "bar_time", "signal", "threshold", "decision", "contracts",
                "ref_price", "fill_price", "slippage_ticks", "order_status", "position",
                "daily_pnl_points", "guard_blocked", "kill_metric_name", "kill_metric_value");
  }

void LogDecision(const BarData &b, const double sig, const string decision, const int lots,
                 const double ref_price, const double fill_price, const double slip,
                 const string status, const string guard)
  {
   if(g_file == INVALID_HANDLE) return;
   string ts = IsoMinute(TimeGMT()) + "Z";
   FileWrite(g_file, ts, IsoMinute(b.close_time), Num(sig), Num(SIGNAL_THRESHOLD), decision,
             IntegerToString(lots), Num(ref_price), Num(fill_price), Num(slip), status,
             IntegerToString(g_position), Num(g_daily_pnl_points), guard, KILL_METRIC_NAME,
             Num(KillMetricValue(b)));
   FileFlush(g_file);
  }

//+------------------------------------------------------------------+
//| Posicao                                                          |
//+------------------------------------------------------------------+
void SyncPosition(void)
  {
   if(!PositionSelect(_Symbol) || (ulong)PositionGetInteger(POSITION_MAGIC) != InpMagic)
     { g_position = 0; return; }
   g_position = PositionGetInteger(POSITION_TYPE) == POSITION_TYPE_BUY ? 1 : -1;
  }

void UpdateDailyPnl(const BarData &b)
  {
   MqlDateTime dt; TimeToStruct(b.close_time, dt);
   dt.hour = 0; dt.min = 0; dt.sec = 0;
   if(!HistorySelect(StructToTime(dt), TimeCurrent())) return;
   double brl = 0.0;
   for(int i = HistoryDealsTotal() - 1; i >= 0; i--)
     {
      ulong d = HistoryDealGetTicket(i);
      if((ulong)HistoryDealGetInteger(d, DEAL_MAGIC) != InpMagic) continue;
      brl += HistoryDealGetDouble(d, DEAL_PROFIT);
     }
   g_daily_pnl_points = brl / POINT_VALUE;
  }

//+------------------------------------------------------------------+
//| Uma barra fechada                                                |
//+------------------------------------------------------------------+
void ProcessBar(const int shift, const bool log_bar, const bool may_trade)
  {
   BarData b;
   if(!LoadBar(shift, b))
     {
      if(log_bar && g_file != INVALID_HANDLE)
        {
         BarData empty; ZeroMemory(empty);
         empty.close_time = iTime(_Symbol, PERIOD_M1, shift) + 60;
         LogDecision(empty, NaNValue(), "NONE", 0, 0.0, NaNValue(), NaNValue(), "", "DATA_GAP");
        }
      return;   // sem dado nao ha passo: o estado nao avanca com informacao incompleta
     }
   if(b.day_key != g_day_key)
     {
      g_gap_points = g_prev_day_close > 0.0 ? b.open - g_prev_day_close : 0.0;
      g_day_key = b.day_key; g_consecutive_rej = 0; g_orders_sent = 0; g_orders_filled = 0;
      if(log_bar) OpenDayFile(b);
     }
   double sig = g_root.Step(b);
   g_bars_seen++;
   g_prev_day_close = b.close;
   if(!log_bar) return;   // aquecimento a partir do historico: sem ordem e sem log

   SyncPosition();
   UpdateDailyPnl(b);
   string decision = "NONE", status = "", guard = "";
   int lots = 0;
   double ref_price = SymbolInfoDouble(_Symbol, SYMBOL_LAST);
   double fill = NaNValue(), slip = NaNValue();

   if(!may_trade) { }   // barra atrasada: so registra
   else if(g_position != 0)
     {
      int held = (int)((b.close_time - g_entry_time) / 60);
      if(b.tod >= CUTOFF_MIN || held >= MAX_HOLDING_MIN)   // zeragem compulsoria ou tempo
        {
         decision = "CLOSE";
         status = g_trade.PositionClose(_Symbol) ? "FILLED" : "REJECTED_" + IntegerToString(g_trade.ResultRetcode());
        }
     }
   else if(!g_fault && g_bars_seen > WARMUP_BARS)
     {
      int side = DecideSide(sig);
      if(side != 0)
        {
         lots = CONTRACTS;
         double quote = side > 0 ? SymbolInfoDouble(_Symbol, SYMBOL_ASK) : SymbolInfoDouble(_Symbol, SYMBOL_BID);
         double px = ToGrid(quote, side);
         guard = GuardOrder(b.tod, lots, px);
         if(guard == "")
           {
            double sl = STOP_POINTS > 0 ? ToGrid(px - side * STOP_POINTS, -side) : 0.0;
            double tp = TARGET_POINTS > 0 ? ToGrid(px + side * TARGET_POINTS, -side) : 0.0;
            g_orders_sent++;
            bool ok = side > 0 ? g_trade.Buy(lots, _Symbol, px, sl, tp) : g_trade.Sell(lots, _Symbol, px, sl, tp);
            uint rc = g_trade.ResultRetcode();
            if(ok && (rc == TRADE_RETCODE_DONE || rc == TRADE_RETCODE_PLACED))
              {
               decision = side > 0 ? "OPEN_LONG" : "OPEN_SHORT";
               status = "FILLED"; g_orders_filled++; g_consecutive_rej = 0;
               g_entry_time = b.close_time;
               fill = g_trade.ResultPrice();
               slip = side * (fill - ref_price) / TICK_SIZE;
              }
            else
              {
               decision = "REJECTED"; status = "REJECTED_" + IntegerToString(rc);
               g_consecutive_rej++;
              }
           }
         else lots = 0;
        }
     }
   SyncPosition();
   LogDecision(b, sig, decision, lots, ref_price, fill, slip, status, guard);
  }

//+------------------------------------------------------------------+
int OnInit(void)
  {
   BuildGraph();
   g_trade.SetExpertMagicNumber(InpMagic);
{%- if needs_es or kill_metric in ("lag_ms", "ref_corr") %}
   if(!SymbolSelect(InpRefES, true)) return INIT_FAILED;
{%- endif %}
{%- if needs_wdo %}
   if(!SymbolSelect(InpRefWDO, true)) return INIT_FAILED;
{%- endif %}
   // aquecimento: reconstroi o estado a partir do historico, barras fechadas apenas
   int start = MathMin(Bars(_Symbol, PERIOD_M1) - 1, 3 * WARMUP_BARS + 2);
   for(int s = start; s >= 2; s--) ProcessBar(s, false, false);
   g_last_processed = iTime(_Symbol, PERIOD_M1, 2);
   return INIT_SUCCEEDED;
  }

void OnDeinit(const int reason)
  {
   if(g_file != INVALID_HANDLE) FileClose(g_file);
   for(int i = ArraySize(g_nodes) - 1; i >= 0; i--)
      if(CheckPointer(g_nodes[i]) == POINTER_DYNAMIC) delete g_nodes[i];
  }

void OnTick(void)
  {
   if(iTime(_Symbol, PERIOD_M1, 1) == g_last_processed) { AccumulateTickMetric(); return; }   // barra nao fechou: sai
   AccumulateTickMetric();
   int from = iBarShift(_Symbol, PERIOD_M1, g_last_processed, true) - 1;
   if(from < 1) from = 1;
   for(int s = from; s >= 1; s--) ProcessBar(s, true, s == 1);   // atrasadas: logadas, sem ordem
   g_last_processed = iTime(_Symbol, PERIOD_M1, 1);
  }
